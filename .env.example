# Application PostgreSQL
POSTGRES_DB=cantera_gt
POSTGRES_USER=cantera_gt_admin
POSTGRES_PASSWORD=change_me_local
BACKEND_URL=localhost:5432

# Keycloak PostgreSQL
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak_admin
POSTGRES_KEYCLOAK_PASSWORD=change_me_local

# Keycloak local development realm
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_local
KEYCLOAK_SERVER_URL=http://localhost:8181
KEYCLOAK_REALM=canteragt-security-realm
KEYCLOAK_ISSUER_URL=http://localhost:8181/realms/canteragt-security-realm
KEYCLOAK_ADMIN_CLIENT_ID=canteragt-api
KEYCLOAK_ADMIN_CLIENT_SECRET=replace_with_keycloak_client_secret
KEYCLOAK_CLIENT_ID=canteragt-api
# Legacy variable retained for local setups; the current backend does not read it.
KEYCLOAK_CLIENT_SECRET=replace_with_legacy_client_secret

# Comma-separated browser origins allowed by the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
